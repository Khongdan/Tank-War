 │ - m_StartDelay: float                         │
 │ - m_EndDelay: float                           │
 │ - m_RoundNumber: int                          │
 │ - m_Tanks: TankManager[]                      │
 │ - m_CameraControl: CameraControl              │
 ├───────────────────────────────────────────────┤
 │ + Start(): void                               │
 │ - GameLoop(): IEnumerator                     │
 │ - RoundStarting(): IEnumerator                │
 │ - RoundPlaying(): IEnumerator                 │
 │ - RoundEnding(): IEnumerator                  │
 │ - OneTankLeft(): bool                         │
 └───────────────────────┬───────────────────────┘
                         │ 1..* (Quản lý)
                         ▼
 ┌───────────────────────────────────────────────┐        ┌──────────────────────────────┐
 │                 TankManager                   │        │        CameraControl         │
 ├───────────────────────────────────────────────┤        ├──────────────────────────────┤
