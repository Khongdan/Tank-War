 │ - m_TurnSpeed: float = 100 │ - m_MaxLaunchForce: float=30│ - m_CurrentHealth: float    │
 │ - m_Rigidbody: Rigidbody   │ - m_AimSlider: Slider       │ - m_Slider: Slider          │
